# Somente no servidor. Nunca usar NEXT_PUBLIC_ para chaves.
# Gecko: configurar em .env.gecko.local (ignorado pelo Git).
GECKO_API_KEY=
# Reef: configurar em .env.reef.local (ignorado pelo Git).
REEF_API_KEY=
# Habilitar somente com créditos promocionais, sem cartão/plano/recarga.
# O provedor não teve saldo autenticado validado no piloto público.
REEF_FREE_TRIAL=false
