# Server-only. Copy to .env.radar.local (ignored) for local development.
# In hosting, use the service's secret/environment settings. Never NEXT_PUBLIC_.
RADAR_SCHEDULER_ENABLED=false
RADAR_CRON_SECRET=
RADAR_APP_URL=
# Existing Resend integration. Server only; use the provider-authorized sender, never the recipient Gmail.
# Enable automatic digests only after the reviewed email test.
RADAR_EMAIL_ENABLED=false
RESEND_API_KEY=
RADAR_EMAIL_FROM=
RADAR_EMAIL_TO=
