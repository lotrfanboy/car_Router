# Server-only. Use .env or .env.radar.local (both ignored) for local development.
# Keep existing database settings. For the email test, RADAR_APP_URL may be
# http://127.0.0.1:3000 (use your local port); deployed apps require HTTPS.
# The test needs RADAR_CRON_SECRET (at least 32 characters) but no active scheduler or radar.
# In hosting, use the service's secret/environment settings. Never NEXT_PUBLIC_.
RADAR_SCHEDULER_ENABLED=false
RADAR_CRON_SECRET=
RADAR_APP_URL=
# Existing Resend integration. Server only; use the provider-authorized sender, never the recipient Gmail.
# Enable automatic digests only after the reviewed email test.
RADAR_EMAIL_ENABLED=false
RESEND_API_KEY=
RADAR_EMAIL_FROM=
RADAR_EMAIL_TO=
