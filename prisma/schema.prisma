generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Vehicle {
  id              String   @id @default(cuid())
  brand           String
  model           String
  version         String?
  manufactureYear Int
  modelYear       Int
  mileage         Int
  priceCents      Int
  referenceCents  Int?
  city            String?
  state           String?
  fuel            String?
  transmission    String?
  source          String
  originalUrl     String?
  imageUrl        String?
  notes           String?
  favorite        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  priceHistory    VehiclePrice[]

  @@index([brand, model])
  @@index([createdAt])
  @@index([favorite])
}

model VehiclePrice {
  id         Int      @id @default(autoincrement())
  vehicleId  String
  priceCents Int
  observedAt DateTime @default(now())
  reason     String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, id])
}

model SavedSearch {
  id        String   @id @default(cuid())
  name      String
  criteria  String
  createdAt DateTime @default(now())
  runs      SearchRun[]
}

model SearchRun {
  id        String   @id @default(cuid())
  searchId  String
  createdAt DateTime @default(now())
  result    String
  search    SavedSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId, createdAt])
}

model DiscoveredListing {
  id         String   @id @default(cuid())
  source     String
  externalId String
  payload    String
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  prices     ListingPrice[]

  @@unique([source, externalId])
}

model ListingPrice {
  id         Int @id @default(autoincrement())
  listingId  String
  priceCents Int
  observedAt DateTime @default(now())
  listing    DiscoveredListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, id])
}

model ProviderSpend {
  id        Int @id @default(autoincrement())
  provider  String
  credits   Int
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}

model SearchLock {
  id        String @id
  expiresAt DateTime
}

model OlxLocation {
  id         String @id
  region     String
  verifiedAt DateTime @default(now())
}
